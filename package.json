{
  "name": "opendocs",
  "version": "2.0.0",
  "description": "Enterprise AI-powered document editor with real-time collaboration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [
    "document",
    "editor",
    "collaboration",
    "real-time",
    "notion",
    "block-editor"
  ],
  "author": "OpenDocs Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-collaboration": "^2.6.0",
    "@tiptap/extension-collaboration-cursor": "^2.6.0",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-table-cell": "^3.19.0",
    "@tiptap/extension-table-header": "^3.19.0",
    "@tiptap/extension-table-row": "^3.19.0",
    "@tiptap/extension-task-item": "^3.19.0",
    "@tiptap/extension-task-list": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^2.6.0",
    "@tiptap/react": "^2.6.0",
    "@tiptap/starter-kit": "^2.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@xyflow/react": "^12.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.1",
    "expr-eval": "^2.0.2",
    "express": "^5.2.1",
    "framer-motion": "^12.34.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.436.0",
    "mermaid": "^11.0.0",
