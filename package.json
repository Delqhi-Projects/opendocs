  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.46.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.19.11",
    "@types/pako": "^2.0.3",
