# ==============================================================================
# OpenDocs - Environment Configuration
# ==============================================================================
# Copy this file to .env (server) and .env.local (frontend) as needed.
# All variables marked with [REQUIRED] must be set for production.
# ==============================================================================

# ==============================================================================
# APPLICATION
# ==============================================================================
VITE_APP_NAME=OpenDocs
VITE_APP_URL=http://localhost:5173
NODE_ENV=development

# ==============================================================================
# NVIDIA API (Primary LLM) [REQUIRED]
# ==============================================================================
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=moonshotai/kimi-k2.5

# ==============================================================================
# SUPABASE [REQUIRED for Database Features]
# ==============================================================================
# Self-hosted or cloud Supabase instance
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Supabase Database Connection
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_DB_SCHEMA=public
SUPABASE_DB_PORT=5432
SUPABASE_API_PORT=8000
SUPABASE_AUTH_PORT=9999
SUPABASE_STORAGE_PORT=5000

# ==============================================================================
# n8n WORKFLOW AUTOMATION [REQUIRED for Visual Workflows]
# ==============================================================================
# [REQUIRED] Credentials must be set explicitly - no defaults!
VITE_N8N_BASE_URL=http://localhost:8058
N8N_API_KEY=your_n8n_api_key_here
N8N_PORT=8058
N8N_USER=your_n8n_admin_user
N8N_PASSWORD=your_secure_n8n_password_here
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# ==============================================================================
# OPENCLAW INTEGRATION
# ==============================================================================
# Server-side only - NEVER expose token to browser
OPENCLAW_BASE_URL=http://localhost:8080
OPENCLAW_API_KEY=your_openclaw_api_key_here
OPENCLAW_PORT=8080

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
# [REQUIRED] Password must be set explicitly - no defaults allowed!
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:54322/postgres
SUPABASE_DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:54322/postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_NAME=postgres

# ==============================================================================
# REDIS (Optional - for caching & sessions)
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3000
APP_PORT=3000
HOST=0.0.0.0

# API Authentication [RECOMMENDED for Production]
API_AUTH_TOKEN=your_secure_api_token_here
VITE_API_AUTH_TOKEN=your_secure_api_token_here

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ==============================================================================
# SECURITY HARDENING
# ==============================================================================
# SSRF protection for website analysis
WEBSITE_FETCH_TIMEOUT_MS=12000
WEBSITE_FETCH_MAX_BYTES=750000
WEBSITE_ALLOW_PRIVATE_IPS=false

# Session Security
SESSION_SECRET=your_session_secret_min_32_chars_here
SESSION_MAX_AGE=86400000

# ==============================================================================
# LOGGING & MONITORING
# ==============================================================================
LOG_LEVEL=info
LOG_FORMAT=pretty

# ==============================================================================
# VOICE API (Optional - for Voice Block transcription and TTS)
# ==============================================================================
# OpenAI API for Whisper transcription (recommended)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API for high-quality TTS (optional - falls back to Edge TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ==============================================================================
# DOCKER COMPOSE (Optional)
# ==============================================================================
COMPOSE_PROJECT_NAME=opendocs

# ==============================================================================
# DEVELOPMENT ONLY
# ==============================================================================
# These settings are for local development only
VITE_DEV_MODE=true
ENABLE_DEVTOOLS=true

# ==============================================================================
# PRODUCTION OVERRIDES
# ==============================================================================
# Uncomment and set these for production deployment
# NODE_ENV=production
# VITE_APP_URL=https://opendocs.yourdomain.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# NVIDIA_API_KEY=prod_nvidia_key
# API_AUTH_TOKEN=production_secure_token
# CORS_ORIGIN=https://opendocs.yourdomain.com
# LOG_LEVEL=warn
# LOG_FORMAT=json
